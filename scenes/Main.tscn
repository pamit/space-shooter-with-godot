"shooter": ExtResource("11")
}

[node name="HUD" parent="." instance=ExtResource("8")]

[node name="GameOverPanel" type="Control" parent="."]
anchors_preset = 15
visible = false
process_mode = 3

[node name="FinalScoreLabel" type="Label" parent="GameOverPanel"]
offset_left = 270.0
offset_top = 500.0
